# SMTP configuration for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_RECIPIENTS=user1@example.com,user2@example.com

# Optional: higher API rate limits and polite-pool access
NCBI_API_KEY=
NCBI_EMAIL=
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=

# Optional: academic Chinese translation of titles/abstracts.
# Any OpenAI-compatible chat-completions API works; leave TRANSLATE_API_KEY empty to disable.
#   DeepSeek   TRANSLATE_API_BASE=https://api.deepseek.com                            TRANSLATE_MODEL=deepseek-chat
#   Qwen       TRANSLATE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1   TRANSLATE_MODEL=qwen-max
#   Moonshot   TRANSLATE_API_BASE=https://api.moonshot.cn/v1                          TRANSLATE_MODEL=<model name>
TRANSLATE_API_KEY=
TRANSLATE_API_BASE=https://api.deepseek.com
TRANSLATE_MODEL=deepseek-chat
# Translate newly found papers automatically during run-pipeline (1/0) and the per-run cap
TRANSLATE_NEW_PAPERS=1
TRANSLATE_MAX_PER_RUN=100

# Optional: restrict databases (comma-separated subset of pubmed,europepmc,biorxiv,arxiv,semantic_scholar,crossref)
GENOME_HUB_SOURCES=

# Optional: web GUI bind address / port
GENOME_HUB_HOST=127.0.0.1
GENOME_HUB_PORT=8686

# GitHub (optional)
GITHUB_TOKEN=
GITHUB_REPO=Yin-Shen/3DGenomeHub
